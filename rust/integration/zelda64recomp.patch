diff --git a/CMakeLists.txt b/CMakeLists.txt
index 1cdda09..9a6d238 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -63,6 +63,14 @@ target_compile_definitions(rmlui_core PRIVATE LUNASVG_BUILD_STATIC)
 
 add_subdirectory(${CMAKE_SOURCE_DIR}/lib/N64ModernRuntime)
 
+# Rust port (github.com/Auxnon/N64Recomp, branch rust-port): replace runtime functions with
+# the Rust versions from rust/recomp-runtime.
+option(RECOMP_RUST_RUNTIME "Link the Rust runtime crate from the n64recomp checkout" OFF)
+if (RECOMP_RUST_RUNTIME)
+    include(${CMAKE_SOURCE_DIR}/../n64recomp/rust/integration/RecompRustRuntime.cmake)
+    recomp_link_rust_runtime(librecomp)
+endif()
+
 target_include_directories(rt64 PRIVATE ${CMAKE_BINARY_DIR}/rt64/src)
 
 # RecompiledFuncs - Library containing the primary recompiler output
@@ -336,7 +344,7 @@ if (CMAKE_SYSTEM_NAME MATCHES "Linux")
     set(THREADS_PREFER_PTHREAD_FLAG TRUE)
     find_package(Threads REQUIRED)
 
-    target_link_libraries(Zelda64Recompiled PRIVATE "-latomic -static-libstdc++" ${CMAKE_DL_LIBS} Threads::Threads)
+    target_link_libraries(Zelda64Recompiled PRIVATE "-latomic" ${CMAKE_DL_LIBS} Threads::Threads)
 endif()
 
 target_link_libraries(Zelda64Recompiled PRIVATE
@@ -409,4 +417,9 @@ target_sources(Zelda64Recompiled PRIVATE ${GENERATED_NRM_SOURCES})
 
 target_sources(Zelda64Recompiled PRIVATE ${SOURCES})
 
+# fast3d-rs renderer, selected at runtime with RECOMP_RENDERER=fast3d.
+if (RECOMP_RUST_RUNTIME AND RECOMP_RUST_FAST3D)
+    recomp_add_fast3d_renderer(Zelda64Recompiled)
+endif()
+
 set_property(TARGET Zelda64Recompiled PROPERTY VS_DEBUGGER_WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
